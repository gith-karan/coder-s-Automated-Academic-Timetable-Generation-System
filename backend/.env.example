# Copy to .env and fill in. NEVER commit .env.
NFSU_ENV=dev                      # dev | test | prod
NFSU_DATABASE_URL=sqlite:///./data/app.db
# prod: NFSU_DATABASE_URL=postgresql+psycopg://nfsu_app:<password>@db:5432/nfsu_timetable
NFSU_SECRET_KEY=change-me-to-64-random-chars
NFSU_AUDIT_HMAC_KEY=change-me-to-a-different-64-random-chars
NFSU_BOOTSTRAP_ADMIN_EMAIL=admin@nfsu.ac.in
NFSU_BOOTSTRAP_ADMIN_PASSWORD=
NFSU_DEMO_PASSWORD=               # dev only
NFSU_CORS_ORIGINS=["http://localhost:5173"]
NFSU_TRUSTED_HOSTS=["localhost","127.0.0.1"]
NFSU_SOLVER_WORKERS=8
NFSU_MAIL_BACKEND=console         # console | smtp
